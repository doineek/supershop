// firestore.rules
// -----------------------------------------------------------------------
// Project: doineek-pos-e4023
// Direct Console Link: https://console.firebase.google.com/project/doineek-pos-e4023/firestore/rules
//
// 🔒 PRODUCTION SECURITY POLICY:
// 1. All direct public client (browser/web/mobile REST) access is BLOCKED (allow read, write: if false).
// 2. Your Flask Web Server (Render) and Desktop POS App communicate via Firebase Admin SDK
//    (Service Account credentials: firebase_credentials.json), which securely bypasses these rules
//    with full administrative and real-time syncing permissions.
// 3. This completely closes the "Test Mode" security vulnerability and stops all Firebase security warning emails.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

